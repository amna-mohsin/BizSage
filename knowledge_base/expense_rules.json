[
 {
  "id": "R11",
  "kind": "diagnostic",
  "category": "Expenses & Profitability",
  "name": "Food cost ratio excessively high",
  "conditions": [
   {
    "fact": "food_cost_ratio",
    "op": "ge",
    "value": "$food_cost_high"
   }
  ],
  "effects": [
   {
    "hypothesis": "H_FOODCOST",
    "cf": 0.5
   },
   {
    "hypothesis": "H_WASTAGE",
    "cf": 0.15
   }
  ],
  "explanation": "Food cost is {food_cost_ratio:.1f}% of sales (the system uses {food_cost_high}% as a warning level).",
  "next_question": "supplier_prices_up",
  "asserts": [
   {
    "fact": "margin_squeeze",
    "value": true
   }
  ]
 },
