[
 {
  "id": "R01",
  "kind": "diagnostic",
  "category": "Revenue & Demand",
  "name": "Revenue declining for consecutive months",
  "conditions": [
   {
    "fact": "revenue_decline_streak",
    "op": "ge",
    "value": 2
   }
  ],
  "effects": [
   {
    "hypothesis": "H_DEMAND",
    "cf": 0.45
   }
  ],
  "explanation": "Revenue has fallen for {revenue_decline_streak:.0f} months in a row.",
  "next_question": "repeat_trend"
 },
